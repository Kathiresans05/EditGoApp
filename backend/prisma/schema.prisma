generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  EDITOR
  ADMIN
}

enum MembershipPlan {
  FREE
  CREATOR_PLUS
  ELITE_CREATOR
}

enum EditorLevel {
  BEGINNER
  RISING_CREATOR
  PRO
  ELITE
  MASTER
  VERIFIED_PREMIUM
}

enum SubscriptionPlan {
  FREE
  PRO
  ELITE
}

enum OrderStatus {
  SEARCHING
  ACCEPTED
  EDITING_STARTED
  TRANSITIONS_ADDING
  COLOR_GRADING
  RENDERING
  EXPORTING
  UPLOADING
  COMPLETED
  CANCELLED
}

enum TrustLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  ELITE
}

enum ContentSensitivity {
  PUBLIC
  PRIVATE
  SENSITIVE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  phone         String    @unique
  name          String?
  email         String?   @unique
  password      String?
  avatar        String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Customer Ecosystem
  creatorType   String?   // "Gamer", "Influencer", etc.
  plan          MembershipPlan @default(FREE)
  walletBalance Float     @default(0)
  referralCode  String?   @unique
  rewardPoints  Int       @default(0)
  
  // Relations
  customerOrders Order[]  @relation("CustomerOrders")
  favoriteEditorIds String[] @db.ObjectId
  favoriteEditors Editor[] @relation("FavoriteEditors", fields: [favoriteEditorIds], references: [id])
  editorProfile  Editor?
  reviews        Review[]
}

model Order {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String      @db.ObjectId
  customer      User        @relation("CustomerOrders", fields: [customerId], references: [id])
  editorId      String?     @db.ObjectId
  editor        Editor?     @relation("EditorOrders", fields: [editorId], references: [id])
  
  title         String
  category      String
  status        OrderStatus @default(SEARCHING)
  price         Float
  progress      Int         @default(0) // 0-100%
  
  instructions  String?
  voiceNoteUrl  String?
  videoUrl      String?
  previews      String[]    // Up to 3 preview links
  finalUrl      String?     // HD Download link
  isPaid        Boolean     @default(false)
  paymentId     String?     // Transaction ID
  
  deliverySpeed String?     // "standard", "turbo", "zap"
  initialETAMins Int?       // Original estimated minutes
  acceptedAt    DateTime?
  isLate        Boolean     @default(false)
  
  contentSensitivity ContentSensitivity @default(PRIVATE)
  privacyAgreementSigned Boolean @default(false)
  
  review        Review?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Editor {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @unique @db.ObjectId
  user            User          @relation(fields: [userId], references: [id])
  
  bio             String?
  skills          String[]      
  level           EditorLevel   @default(BEGINNER)
  badges          String[]      
  plan            SubscriptionPlan @default(FREE)
  
  // Stats
  rating          Float         @default(0)
  totalOrders     Int           @default(0)
  responseSpeed   String?       
  successRate     Float         @default(100)
  
  // Links
  instagramUrl    String?
  youtubeUrl      String?
  portfolio       PortfolioItem[]
  
  // Earnings
  balance         Float         @default(0)
  totalEarnings   Float         @default(0)
  
  isOnline        Boolean       @default(false)
  
  // Verification
  verificationStatus VerificationStatus @default(PENDING)
  aadhaarNumber      String?   
  panNumber          String?   
  idDocumentUrl      String?   
  selfieUrl          String?   
  bankAccount        String?   
  isVerified         Boolean   @default(false)
  verifiedAt         DateTime?
  
  // Trust & Security
  trustScore         Int          @default(50)
  trustLevel         TrustLevel   @default(BRONZE)
  violationCount     Int          @default(0)
  isSuspended        Boolean      @default(false)
  suspensionReason   String?
  suspensionEnd      DateTime?

  favoritedByIds  String[]      @db.ObjectId
  favoritedBy     User[]        @relation("FavoriteEditors", fields: [favoritedByIds], references: [id])
  orders          Order[]       @relation("EditorOrders")
  violations         ViolationReport[]
  accessLogs         FileAccessLog[]
  reviews            Review[]
}

model PortfolioItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  editorId    String   @db.ObjectId
  editor      Editor   @relation(fields: [editorId], references: [id])
  title       String
  thumbnail   String
  videoUrl    String
  beforeUrl   String?  
  category    String   
  likes       Int      @default(0)
}

model ViolationReport {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  editorId    String   @db.ObjectId
  editor      Editor   @relation(fields: [editorId], references: [id])
  reporterId  String?  @db.ObjectId // Customer or Admin ID
  orderId     String?  @db.ObjectId
  
  type        String   // "CONTENT_MISUSE", "PRIVACY_BREACH", etc.
  severity    ViolationSeverity
  description String
  evidenceUrl String?
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  adminNotes  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FileAccessLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  editorId    String   @db.ObjectId
  editor      Editor   @relation(fields: [editorId], references: [id])
  orderId     String   @db.ObjectId
  
  fileType    String   // "ORIGINAL", "DRAFT", "FINAL"
  action      String   // "VIEW", "DOWNLOAD"
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String   @unique @db.ObjectId
  order       Order    @relation(fields: [orderId], references: [id])
  editorId    String   @db.ObjectId
  editor      Editor   @relation(fields: [editorId], references: [id])
  customerId  String   @db.ObjectId
  customer    User     @relation(fields: [customerId], references: [id])
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
}

